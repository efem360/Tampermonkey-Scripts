// ==UserScript==
// @name         Google Images Quick Viewer
// @namespace    https://github.com/efem360
// @version      1.1
// @description  Google Görseller'e F1 tuşuyla hızlı görüntüleme butonları ekler. Tek tıkla orijinal görseli açın.
// @author       Kemal Kalender
// @homepageURL  https://github.com/efem360/Tampermonkey-Scripts/tree/main/Google-Images-Quick-View-Button
// @supportURL   https://github.com/efem360/Tampermonkey-Scripts/tree/main/Google-Images-Quick-View-Button/issues
// @icon         https://www.google.com/favicon.ico
// @license      GPL 3.0
// @match        https://www.google.com.tr/search?*tbm=isch*
// @match        https://www.google.com.tr/search?*udm=2*
// @match        https://www.google.com/search?*tbm=isch*
// @match        https://www.google.com/search?*udm=2*
// @updateURL    https://raw.githubusercontent.com/efem360/Tampermonkey-Scripts/main/Google-Images-Quick-View-Button/Google-Images-Quick-View-Button.js
// @downloadURL  https://raw.githubusercontent.com/efem360/Tampermonkey-Scripts/main/Google-Images-Quick-View-Button/Google-Images-Quick-View-Button.js
// @run-at       document-idle
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    const BUTTON_CLASS = 'google-view-btn';
    const INFO_ID = 'google-view-info';

    let totalAdded = 0;
    let observer = null;

    const style = document.createElement('style');

    style.textContent = `
        .${BUTTON_CLASS} {
            position: absolute;
            right: 5px;
            bottom: 5px;
            z-index: 9999;
            background: rgba(0, 0, 0, 0.75);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 3px 7px;
            font-size: 13px;
            line-height: 1.4;
            cursor: pointer;
            transition: background 0.2s;
        }

        .${BUTTON_CLASS}:hover {
            background: rgba(0, 0, 0, 0.95);
        }
    `;

    document.head.appendChild(style);

    function getImageUrl(link) {
        try {
            const url = new URL(link.href);
            const imageUrl = url.searchParams.get('imgurl');

            if (!imageUrl || !/^https?:\/\//i.test(imageUrl)) {
                return null;
            }

            if (imageUrl.includes('gstatic.com')) {
                return null;
            }

            return imageUrl;

        } catch {
            return null;
        }
    }

    function getContainer(link) {
        return link.closest('[jsname], [data-attrid]');
    }

    function addButtons() {
        let added = 0;

        const links = document.querySelectorAll('a[href*="imgurl="]');

        links.forEach(link => {
            if (link.dataset.googleViewProcessed === '1') {
                return;
            }

            const imageUrl = getImageUrl(link);

            if (!imageUrl) {
                return;
            }

            const container = getContainer(link);

            if (!container || container.querySelector(`.${BUTTON_CLASS}`)) {
                return;
            }

            link.dataset.googleViewProcessed = '1';

            if (getComputedStyle(container).position === 'static') {
                container.style.position = 'relative';
            }

            const button = document.createElement('button');

            button.type = 'button';
            button.className = BUTTON_CLASS;
            button.textContent = '📷';
            button.title = 'Resmi Görüntüle';

            button.addEventListener('click', event => {
                event.preventDefault();
                event.stopPropagation();

                window.open(imageUrl, '_blank', 'noopener,noreferrer');
            });

            container.appendChild(button);

            added++;
        });

        totalAdded += added;

        return added;
    }

    function showInfo() {
        if (document.getElementById(INFO_ID)) {
            return;
        }

        const info = document.createElement('div');

        info.id = INFO_ID;

        info.innerHTML = `
            ⌨️ <b>F1</b> tuşuna bas → Görsel butonlarını ekle
        `;

        info.style.cssText = `
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: #1a73e8;
            color: white;
            padding: 9px 16px;
            border-radius: 8px;
            font-size: 13px;
            z-index: 10000;
            font-family: Arial, sans-serif;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
            cursor: pointer;
        `;

        info.addEventListener('click', () => info.remove());

        document.body.appendChild(info);

        setTimeout(() => info.remove(), 8000);
    }

    function startObserver() {
        if (observer) {
            return;
        }

        observer = new MutationObserver(() => {
            if (document.querySelector('a[href*="imgurl="]')) {
                addButtons();
            }
        });

        observer.observe(document.body, {
            childList: true,
            subtree: true
        });
    }

    document.addEventListener('keydown', event => {
        if (
            event.key !== 'F1' ||
            event.repeat ||
            event.ctrlKey ||
            event.altKey ||
            event.metaKey
        ) {
            return;
        }

        event.preventDefault();

        const added = addButtons();

        showInfo();

        if (added > 0) {
            console.info(`Google Görsel: ${added} yeni buton eklendi. Toplam: ${totalAdded}`);
        }
    });

    startObserver();
    showInfo();

})();
